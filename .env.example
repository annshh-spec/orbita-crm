# Скопируйте этот файл в .env и заполните

# Название вашей CRM (страница входа, письма)
APP_NAME=Орбита
# Название вашей собственной компании внутри Орбиты
COMPANY_NAME=Аляви

# Адрес сайта CRM (ваш домен, с https)
APP_URL=https://crm.example.ru
PORT=3000
# 1 — если сайт работает за nginx (так и будет на сервере)
TRUST_PROXY=1

# Регистрация новых компаний кнопкой «Зарегистрироваться» (1 — включена, 0 — выключена)
# Компания отправляет заявку с ИНН и документами; после одобрения в разделе «Заявки»
# её директор входит со своим email и паролем
ALLOW_REGISTRATION=1
# Кто видит раздел «Заявки» и одобряет компании (кроме ADMIN_EMAIL), через запятую
PLATFORM_ADMINS=

# Необязательно: директор первой компании (создаётся при первом запуске)
# Можно не заполнять и просто зарегистрироваться на сайте
ADMIN_NAME=Анна
ADMIN_EMAIL=director@example.ru
ADMIN_PASSWORD=ПридумайтеНадёжныйПароль2026

# Почта для писем-приглашений сотрудникам (SMTP)
# Пример для Яндекс 360 / Яндекс Почты: нужен «пароль приложения» из настроек Яндекс ID
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=crm@example.ru
SMTP_PASS=пароль_приложения
SMTP_FROM=CRM <crm@example.ru>


# Почта сотрудников (раздел «Почта»). Пароли ящиков шифруются ключом.
# Если не указать, ключ создастся сам в файле data/mail.key — не теряйте его при переносе сервера.
# MAIL_SECRET=длинная-случайная-строка
